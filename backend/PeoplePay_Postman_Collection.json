{
	"info": {
		"_postman_id": "peoplepay-api-collection",
		"name": "PeoplePay API Collection",
		"description": "Complete API collection for PeoplePay (Odoo Final Hackathon) with RBAC, Auth, Attendance, Employees, Departments, and Working Schedules.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication & RBAC",
			"item": [
				{
					"name": "Register User (Admin Only / Bootstrap)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Admin User\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123!\",\n  \"role\": \"admin\",\n  \"is_active\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/register",
							"host": ["{{base_url}}"],
							"path": ["auth", "register"]
						},
						"description": "Creates a new user. If DB has 0 users, creates the initial Admin without cookies. Otherwise requires an Admin cookie."
					}
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/auth/login",
							"host": ["{{base_url}}"],
							"path": ["auth", "login"]
						},
						"description": "Logs in user and sets the 'access_token' cookie."
					}
				},
				{
					"name": "Get Current User Profile (/me)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/me",
							"host": ["{{base_url}}"],
							"path": ["auth", "me"]
						}
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/auth/logout",
							"host": ["{{base_url}}"],
							"path": ["auth", "logout"]
						}
					}
				}
			]
		},
		{
			"name": "2. Attendance",
			"item": [
				{
					"name": "Check-In (Self-Service)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/attendance/check-in",
							"host": ["{{base_url}}"],
							"path": ["attendance", "check-in"]
						}
					}
				},
				{
					"name": "Check-Out (Self-Service)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/attendance/check-out",
							"host": ["{{base_url}}"],
							"path": ["attendance", "check-out"]
						}
					}
				},
				{
					"name": "Navbar Widget State",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/attendance/widget",
							"host": ["{{base_url}}"],
							"path": ["attendance", "widget"]
						}
					}
				},
				{
					"name": "List Attendance Records",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/attendance?skip=0&limit=50",
							"host": ["{{base_url}}"],
							"path": ["attendance"],
							"query": [
								{
									"key": "skip",
									"value": "0"
								},
								{
									"key": "limit",
									"value": "50"
								}
							]
						}
					}
				},
				{
					"name": "Manual Create Attendance (HR / Admin)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"employee_id\": 1,\n  \"check_in\": \"2026-09-05T09:00:00Z\",\n  \"check_out\": \"2026-09-05T18:00:00Z\",\n  \"notes\": \"Manual entry by HR\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/attendance",
							"host": ["{{base_url}}"],
							"path": ["attendance"]
						}
					}
				},
				{
					"name": "Manual Update Attendance (HR / Admin)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"check_in\": \"2026-09-05T09:30:00Z\",\n  \"check_out\": \"2026-09-05T18:30:00Z\",\n  \"notes\": \"Updated attendance notes\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/attendance/1",
							"host": ["{{base_url}}"],
							"path": ["attendance", "1"]
						}
					}
				}
			]
		},
