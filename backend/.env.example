# Copy this file to .env and adjust if needed.
# Environment mode: development or production.
# In production the auth cookie is marked Secure (HTTPS only) automatically.
APP_ENV=development

# Must match the database created by docker-compose.yml
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/odoo-final_db

JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Auth cookie settings (the cookie holds the JWT and is httpOnly).
COOKIE_NAME=access_token
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax